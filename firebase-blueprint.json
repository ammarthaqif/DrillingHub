{
  "entities": {
    "items": {
      "title": "Tubular Item",
      "description": "Drilling tubular, casing, tubing, or downhole tool item record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tagNumber": { "type": "string" },
        "rfidChipId": { "type": "string" },
        "category": { "type": "string" },
        "outerDiameter": { "type": "string" },
        "weightPpf": { "type": "string" },
        "grade": { "type": "string" },
        "connectionType": { "type": "string" },
        "lengthFt": { "type": "number" },
        "serialNumber": { "type": "string" },
        "heatNumber": { "type": "string" },
        "status": { "type": "string" },
        "currentLocation": { "type": "string" },
        "assignedWell": { "type": "string" },
        "holeSection": { "type": "string" },
        "inspectionDueDate": { "type": "string" },
        "lastInspectionDate": { "type": "string" },
        "certificationDocRef": { "type": "string" },
        "isSurplus": { "type": "boolean" },
        "monthsAtYard": { "type": "number" },
        "purchaseCostUsd": { "type": "number" }
      },
      "required": ["id", "tagNumber", "category", "status", "currentLocation"]
    },
    "transfers": {
      "title": "Material Transfer Ticket",
      "description": "Material movement manifest between supply base, rig, and vendor yard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "manifestNumber": { "type": "string" },
        "originLocation": { "type": "string" },
        "destinationLocation": { "type": "string" },
        "status": { "type": "string" },
        "dispatchDate": { "type": "string" },
        "vesselOrTruckName": { "type": "string" },
        "createdByName": { "type": "string" },
        "approvalRole": { "type": "string" }
      },
      "required": ["id", "manifestNumber", "originLocation", "destinationLocation", "status"]
    },
    "users": {
      "title": "User Profile",
      "description": "User registration and access control profile with Microsoft Entra ID authentication",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "isCorporateVerified": { "type": "boolean" },
        "corporateDomain": { "type": "string" },
        "isMicrosoftAuthenticated": { "type": "boolean" },
        "msAuthUid": { "type": "string" },
        "msTenantId": { "type": "string" },
        "lastMicrosoftLoginAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role"]
    },
    "email_outbox": {
      "title": "Verification Email Outbox",
      "description": "Dispatched corporate email validation tokens and records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "userName": { "type": "string" },
        "corporateDomain": { "type": "string" },
        "token": { "type": "string" },
        "sentAt": { "type": "string" },
        "status": { "type": "string" },
        "verificationLink": { "type": "string" }
      },
      "required": ["id", "recipientEmail", "token", "status"]
    },
    "config": {
      "title": "System Configuration",
      "description": "Global application configuration parameters and Microsoft domain whitelists",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "corporateDomains": { "type": "array" },
        "autoApproveVerifiedCorporateEmails": { "type": "boolean" },
        "defaultAfeCode": { "type": "string" },
        "vismaErpSyncEnabled": { "type": "boolean" },
        "vismaEndpointUrl": { "type": "string" }
      },
      "required": ["key"]
    },
    "campaigns": {
      "title": "Drilling Campaign & Project",
      "description": "Drilling campaign encompassing multiple wells, rigs, supply bases, and assigned focals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "operator": { "type": "string" },
        "status": { "type": "string" },
        "startDate": { "type": "string" }
      },
      "required": ["id", "code", "name", "status"]
    },
    "backups": {
      "title": "Database Backup Vault",
      "description": "Scheduled and on-demand local/cloud database snapshot backup point",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdByName": { "type": "string" },
        "backupType": { "type": "string" }
      },
      "required": ["id", "timestamp", "backupType"]
    },
    "rig_backloads": {
      "title": "Rig Backload Manifest",
      "description": "Rig return manifest for tubulars and equipment shipped to supply base",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "manifestNumber": { "type": "string" },
        "rigName": { "type": "string" },
        "vesselName": { "type": "string" },
        "createdTimestamp": { "type": "string" }
      },
      "required": ["id", "manifestNumber", "rigName"]
    },
    "surplus_bookings": {
      "title": "Surplus Booking Request",
      "description": "Multi-stage surplus tubular reservation and well transfer record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetProject": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "targetProject", "status"]
    },
    "material_requisitions": {
      "title": "Material Requisition Form",
      "description": "Drilling engineer tubular and equipment requisition form",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "wellName": { "type": "string" },
        "afeNumber": { "type": "string" }
      },
      "required": ["id", "wellName"]
    },
    "rig_callouts": {
      "title": "Rig Callout",
      "description": "Rig site material callout dispatch notice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rigName": { "type": "string" },
        "requiredDate": { "type": "string" }
      },
      "required": ["id", "rigName"]
    },
    "audit_logs": {
      "title": "Audit Trail Log",
      "description": "Immutable compliance and security event log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actionType": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "actionType", "timestamp", "userId"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/items" },
      "description": "Master OCTG tubulars and drilling tools inventory"
    },
    "/transfers/{transferId}": {
      "schema": { "$ref": "#/entities/transfers" },
      "description": "Material movement tickets between yards and rigs"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "Authorized corporate user directory and authentication profiles"
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/campaigns" },
      "description": "Multi-well drilling campaigns and operational programs"
    },
    "/backups/{backupId}": {
      "schema": { "$ref": "#/entities/backups" },
      "description": "System database snapshot backup vault points"
    },
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/config" },
      "description": "Global enterprise security and system configuration"
    },
    "/email_outbox/{emailId}": {
      "schema": { "$ref": "#/entities/email_outbox" },
      "description": "Corporate email notifications and authorization tokens"
    },
    "/rig_backloads/{backloadId}": {
      "schema": { "$ref": "#/entities/rig_backloads" },
      "description": "Offshore and onshore rig return manifests"
    },
    "/surplus_bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/surplus_bookings" },
      "description": "Surplus asset booking and project transfer workflows"
    },
    "/material_requisitions/{requisitionId}": {
      "schema": { "$ref": "#/entities/material_requisitions" },
      "description": "Drilling engineer material service requisition forms"
    },
    "/rig_callouts/{calloutId}": {
      "schema": { "$ref": "#/entities/rig_callouts" },
      "description": "Rig site material callout orders and transport bookings"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/audit_logs" },
      "description": "Immutable compliance and security audit logs"
    }
  }
}
