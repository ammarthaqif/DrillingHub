rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Primitive Validation Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // Default Catch-All: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Items Collection - Master OCTG Tubulars & Drilling Equipment
    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isValidId(itemId);
      allow delete: if isValidId(itemId);
    }

    // Transfers Collection - Material Movement Manifests
    match /transfers/{transferId} {
      allow read: if true;
      allow create, update: if isValidId(transferId);
      allow delete: if isValidId(transferId);
    }

    // Users Collection - Authorized Corporate Personnel Directory
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    // Email Outbox Collection - Dispatched Verification Tokens
    match /email_outbox/{emailId} {
      allow read: if true;
      allow create, update: if isValidId(emailId);
      allow delete: if isValidId(emailId);
    }

    // System Config Collection - Global Settings & Whitelisted Domains
    match /config/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId);
      allow delete: if isValidId(configId);
    }

    // Drilling Campaigns Collection - Operational Programs & Well Data
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update: if isValidId(campaignId);
      allow delete: if isValidId(campaignId);
    }

    // Database Backup Vault Collection - Snapshots
    match /backups/{backupId} {
      allow read: if true;
      allow create, update: if isValidId(backupId);
      allow delete: if isValidId(backupId);
    }

    // Rig Backloads Collection - Offshore Return Manifests
    match /rig_backloads/{backloadId} {
      allow read: if true;
      allow create, update: if isValidId(backloadId);
      allow delete: if isValidId(backloadId);
    }

    // Surplus Bookings Collection - Reallocations
    match /surplus_bookings/{bookingId} {
      allow read: if true;
      allow create, update: if isValidId(bookingId);
      allow delete: if isValidId(bookingId);
    }

    // Material Requisitions Collection - MSRF Requests
    match /material_requisitions/{requisitionId} {
      allow read: if true;
      allow create, update: if isValidId(requisitionId);
      allow delete: if isValidId(requisitionId);
    }

    // Rig Callouts Collection - Dispatch Requests
    match /rig_callouts/{calloutId} {
      allow read: if true;
      allow create, update: if isValidId(calloutId);
      allow delete: if isValidId(calloutId);
    }

    // Audit Logs Collection - Immutable Compliance Records
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false; // Immutable audit trail
    }

    // Presence Collection - Real-time Online Active User Sessions
    match /presence/{presenceId} {
      allow read: if true;
      allow create, update: if isValidId(presenceId);
      allow delete: if isValidId(presenceId);
    }
  }
}


